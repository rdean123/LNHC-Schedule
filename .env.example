# Supabase project (Project Settings > API). Both values are safe for the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# NEVER put these in a VITE_ variable or in any file the browser loads:
#   the service-role / secret key, or the database connection string (DATABASE_URL).
# Anything starting with VITE_ is published to every visitor.

# Legacy FastAPI backend, only while the old screens still run (removed after Phase 5).
VITE_API_URL=http://127.0.0.1:8000
